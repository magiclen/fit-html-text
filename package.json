{
    "name": "fit-html-text",
    "version": "0.3.0",
    "description": "Fit text into its surrounding container.",
    "keywords": [
        "font-size",
        "html",
        "text"
    ],
    "homepage": "https://magiclen.org/fit-html-text/",
    "bugs": {
        "url": "https://github.com/magiclen/fit-html-text/issues"
    },
    "license": "MIT",
    "author": "Magic Len",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/magiclen/fit-html-text.git"
    },
    "files": [
        "lib",
        "dist"
    ],
    "type": "module",
    "types": "./lib/index.d.ts",
    "exports": "./lib/index.js",
    "scripts": {
        "test": "tsx --test",
        "clean": "rimraf lib dist",
        "typecheck": "tsc -p tsconfig.build.json --noEmit",
        "build": "npm run clean && rslib build",
        "build:watch": "rslib build --watch",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "knip": "knip",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm run knip",
        "prepare": "node setup-git-hooks.mjs",
        "prepack": "npm run build",
        "prepublishOnly": "npm run check && npm run test"
    },
    "devDependencies": {
        "@rslib/core": "^1.0.1",
        "@types/node": "^26.6.2",
        "knip": "^6.37.0",
        "oxfmt": "^0.68.0",
        "oxlint": "^1.83.0",
        "oxlint-tsgolint": "^7.0.2002",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=24"
    },
    "knip": {
        "ignore": [
            "dist/**"
        ]
    }
}
